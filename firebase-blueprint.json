{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile with role, job title, account status, and assigned project access.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 150 },
        "jobTitle": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["admin", "site"] },
        "allProjects": { "type": "boolean" },
        "canAccessExecutedWorks": { "type": "boolean" },
        "canAccessSiteDeliverables": { "type": "boolean" },
        "assignedProjects": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "disabled"] },
        "phone": { "type": "string", "maxLength": 40 },
        "photoUrl": { "type": "string", "maxLength": 350000 },
        "notificationPreferences": {
          "type": "object",
          "properties": {
            "dailyReports": { "type": "boolean" },
            "tasks": { "type": "boolean" },
            "urgentTasksOnly": { "type": "boolean" },
            "issues": { "type": "boolean" },
            "urgentIssuesOnly": { "type": "boolean" },
            "deliverables": { "type": "boolean" },
            "executedWorks": { "type": "boolean" },
            "announcements": { "type": "boolean" }
          },
          "required": [
            "dailyReports",
            "tasks",
            "urgentTasksOnly",
            "issues",
            "urgentIssuesOnly",
            "deliverables",
            "executedWorks",
            "announcements"
          ]
        },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "email", "displayName", "role", "assignedProjects", "status", "createdAt", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Construction site / project tracked by Document Control including scope of work.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "code": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 1000 },
        "workScope": { "type": "string", "maxLength": 2000 },
        "scopeDisciplines": { "type": "array" },
        "plannedWorksCount": { "type": "number" },
        "location": { "type": "string", "maxLength": 200 },
        "clientName": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["active", "completed"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "code", "status", "createdAt", "updatedAt"]
    },
    "DailyReport": {
      "title": "DailyReport",
      "description": "Daily site work report with submitted and received engineering submittals.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectName": { "type": "string", "maxLength": 200 },
        "reportDate": { "type": "string", "maxLength": 20 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 150 },
        "senderEmail": { "type": "string", "maxLength": 200 },
        "originalSenderName": { "type": "string", "maxLength": 150 },
        "originalSenderEmail": { "type": "string", "maxLength": 200 },
        "identitySyncedAt": { "type": "string", "maxLength": 64 },
        "submittedWorks": { "type": "array" },
        "receivedWorks": { "type": "array" },
        "notes": { "type": "string", "maxLength": 4000 },
        "attachments": { "type": "array" },
        "status": { "type": "string", "enum": ["submitted", "reviewed", "needs_revision"] },
        "adminFeedback": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "projectId", "projectName", "reportDate", "senderId", "senderName", "senderEmail", "submittedWorks", "receivedWorks", "status", "createdAt", "updatedAt"]
    },
    "IssueReport": {
      "title": "IssueReport",
      "description": "Site issue or blocker escalated to Document Control.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "issueNumber": { "type": "string", "maxLength": 40 },
        "projectId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectName": { "type": "string", "maxLength": 200 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 150 },
        "type": { "type": "string", "enum": ["equipment", "network", "electrical_ac", "documents_archive", "other"] },
        "priority": { "type": "string", "enum": ["normal", "urgent"] },
        "description": { "type": "string", "maxLength": 4000 },
        "photoUrl": { "type": "string", "maxLength": 900000 },
        "status": { "type": "string", "enum": ["new", "in_progress", "resolved"] },
        "adminComment": { "type": "string", "maxLength": 2000 },
        "resolvedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "issueNumber", "projectId", "projectName", "authorId", "authorName", "type", "priority", "description", "status", "createdAt", "updatedAt"]
    },
    "ProjectTask": {
      "title": "ProjectTask",
      "description": "Document Control task assigned to a project site.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectName": { "type": "string", "maxLength": 200 },
        "title": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 4000 },
        "deadline": { "type": "string", "maxLength": 20 },
        "priority": { "type": "string", "enum": ["normal", "urgent"] },
        "status": { "type": "string", "enum": ["pending", "in_progress", "done"] },
        "createdBy": { "type": "string", "maxLength": 128 },
        "completedBy": { "type": "string", "maxLength": 150 },
        "completedAt": { "type": "string", "maxLength": 64 },
        "proofNote": { "type": "string", "maxLength": 2000 },
        "proofAttachment": { "type": "string", "maxLength": 1000 },
        "attachments": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "projectId", "projectName", "title", "description", "deadline", "priority", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Administrative circular sent by DC management to projects.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 300 },
        "content": { "type": "string", "maxLength": 5000 },
        "targetProjects": { "type": "array" },
        "isUrgent": { "type": "boolean" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 150 },
        "readBy": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "title", "content", "targetProjects", "isUrgent", "createdBy", "authorName", "readBy", "createdAt"]
    },
    "ExecutedWork": {
      "title": "ExecutedWork",
      "description": "Physical construction work executed on site logged by site engineers and reviewed by DC.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectName": { "type": "string", "maxLength": 200 },
        "workDate": { "type": "string", "maxLength": 20 },
        "workDescription": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "discipline": { "type": "string", "enum": ["civil_structural", "architectural", "electrical", "mechanical", "finishing", "infrastructure", "other"] },
        "locationArea": { "type": "string", "maxLength": 200 },
        "quantity": { "type": "number" },
        "unit": { "type": "string", "maxLength": 40 },
        "completionPercent": { "type": "number" },
        "relatedSubmittalNumber": { "type": "string", "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 2000 },
        "attachments": { "type": "array" },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 150 },
        "reviewStatus": { "type": "string", "enum": ["pending", "approved"] },
        "adminNote": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "projectId", "projectName", "workDate", "workDescription", "discipline", "completionPercent", "authorId", "authorName", "reviewStatus", "createdAt", "updatedAt"]
    },
    "SiteDeliverable": {
      "title": "SiteDeliverable",
      "description": "PDF deliverable sent from construction site to Document Control, auto-deleted after 48 hours.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectName": { "type": "string", "maxLength": 200 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "deliverableType": { "type": "string", "enum": ["ir", "mir", "shop_drawing", "handover", "other"] },
        "submittalNumber": { "type": "string", "maxLength": 120 },
        "rev": { "type": "number" },
        "notes": { "type": "string", "maxLength": 2000 },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 260 },
        "fileFormat": { "type": "string", "enum": ["pdf", "excel"] },
        "mimeType": { "type": "string", "maxLength": 150 },
        "fileSizeBytes": { "type": "number" },
        "chunkCount": { "type": "number" },
        "pageCount": { "type": "number" },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 150 },
        "senderEmail": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["pending_receipt", "received", "needs_revision"] },
        "adminNote": { "type": "string", "maxLength": 1000 },
        "receivedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "expiresAtMs": { "type": "number" }
      },
      "required": ["id", "projectId", "projectName", "title", "deliverableType", "fileName", "fileSizeBytes", "chunkCount", "senderId", "senderName", "senderEmail", "status", "createdAt", "updatedAt", "expiresAt", "expiresAtMs"]
    },
    "SiteDeliverableChunk": {
      "title": "SiteDeliverableChunk",
      "description": "Base64 PDF data chunk stored under a SiteDeliverable document.",
      "type": "object",
      "properties": {
        "index": { "type": "number" },
        "data": { "type": "string", "minLength": 1, "maxLength": 800000 },
        "expiresAtMs": { "type": "number" }
      },
      "required": ["index", "data", "expiresAtMs"]
    },
    "ReportAttachmentChunk": {
      "title": "ReportAttachmentChunk",
      "description": "Chunked Base64 file payload stored under a DailyReport document for persistent attachments up to 5MB.",
      "type": "object",
      "properties": {
        "attachmentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "index": { "type": "number" },
        "data": { "type": "string", "minLength": 1, "maxLength": 800000 }
      },
      "required": ["attachmentId", "index", "data"]
    },
    "TaskAttachmentChunk": {
      "title": "TaskAttachmentChunk",
      "description": "Temporary 48-hour chunked Base64 file payload attached by Admin to a ProjectTask (up to 25MB).",
      "type": "object",
      "properties": {
        "attachmentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "index": { "type": "number" },
        "data": { "type": "string", "minLength": 1, "maxLength": 800000 },
        "expiresAtMs": { "type": "number" }
      },
      "required": ["attachmentId", "index", "data", "expiresAtMs"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "Real-time notification for reports, issues, PDF uploads, tasks, and reviews.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "type": {
          "type": "string",
          "enum": [
            "urgent_issue",
            "issue_reported",
            "missing_report",
            "task_assigned",
            "announcement",
            "status_alert",
            "report_submitted",
            "report_reviewed",
            "issue_status",
            "task_done",
            "work_logged",
            "deliverable_sent",
            "deliverable_reviewed"
          ]
        },
        "priority": { "type": "string", "enum": ["normal", "urgent"] },
        "linkTab": { "type": "string", "maxLength": 64 },
        "targetRole": { "type": "string", "enum": ["admin", "site", "all"] },
        "targetUserId": { "type": "string", "maxLength": 128 },
        "projectId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 150 },
        "readBy": { "type": "array" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "title", "message", "type", "isRead", "createdAt"]
    },
    "PersonalNote": {
      "title": "PersonalNote",
      "description": "Private daily personal checklist note visible strictly to its owner.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "noteDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "isCompleted": { "type": "boolean" },
        "isStarred": { "type": "boolean" },
        "carriedOverFrom": { "type": "string", "maxLength": 20 },
        "completedAt": { "type": "string", "maxLength": 64 },
        "reminderDate": { "type": "string", "maxLength": 10 },
        "reminderTime": { "type": "string", "maxLength": 5 },
        "reminderDismissed": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "noteDate", "text", "isCompleted", "createdAt", "updatedAt"]
    },
    "AppBrandingSettings": {
      "title": "AppBrandingSettings",
      "description": "Global application branding settings (custom primary brand color) managed by admins.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "enum": ["branding"], "maxLength": 32 },
        "brandColor": { "type": "string", "minLength": 7, "maxLength": 7, "pattern": "^#[0-9a-fA-F]{6}$" },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedByName": { "type": "string", "maxLength": 150 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "brandColor", "updatedAt"]
    },
    "ActivityLogEntry": {
      "title": "ActivityLogEntry",
      "description": "Immutable system activity audit entry tracking user and admin changes on Daily Reports and Project Tasks.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "entityType": { "type": "string", "enum": ["report", "task"] },
        "action": {
          "type": "string",
          "enum": [
            "report_created",
            "report_updated",
            "report_reviewed",
            "report_deleted",
            "task_created",
            "task_updated",
            "task_completed",
            "task_deleted"
          ]
        },
        "entityId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "entityTitle": { "type": "string", "minLength": 1, "maxLength": 300 },
        "projectId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "actorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorName": { "type": "string", "minLength": 1, "maxLength": 150 },
        "actorEmail": { "type": "string", "maxLength": 200 },
        "actorRole": { "type": "string", "enum": ["admin", "site"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
        "details": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": [
        "id",
        "entityType",
        "action",
        "entityId",
        "entityTitle",
        "projectId",
        "projectName",
        "actorId",
        "actorName",
        "actorRole",
        "summary",
        "createdAt"
      ]
    },
    "SharedExcelLogFile": {
      "title": "SharedExcelLogFile",
      "description": "Cloud-synced Excel log workbook metadata uploaded in the logs tab for a project so admins and authorized engineers share it automatically.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 260 },
        "fileSizeBytes": { "type": "number" },
        "chunkCount": { "type": "number" },
        "uploadedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "uploaderName": { "type": "string", "minLength": 1, "maxLength": 150 },
        "uploaderRole": { "type": "string", "enum": ["admin", "site"] },
        "sourceLabel": { "type": "string", "maxLength": 200 },
        "sheetOverridesJson": { "type": "string", "maxLength": 30000 },
        "excludedSheetIndices": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": [
        "id",
        "projectId",
        "projectName",
        "fileName",
        "fileSizeBytes",
        "chunkCount",
        "uploadedBy",
        "uploaderName",
        "uploaderRole",
        "createdAt",
        "updatedAt"
      ]
    },
    "SharedExcelLogChunk": {
      "title": "SharedExcelLogChunk",
      "description": "Chunked Base64 binary payload belonging to a SharedExcelLogFile.",
      "type": "object",
      "properties": {
        "index": { "type": "number" },
        "data": { "type": "string", "minLength": 1, "maxLength": 800000 }
      },
      "required": ["index", "data"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User accounts created and managed by Admin, keyed by Firebase Auth UID."
    },
    "/users/{userId}/personalNotes/{noteId}": {
      "schema": { "$ref": "#/entities/PersonalNote" },
      "description": "Private daily personal tasks and notes strictly isolated to the owning user."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Construction projects and sites."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/DailyReport" },
      "description": "Daily work reports submitted by site engineers."
    },
    "/reports/{reportId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/ReportAttachmentChunk" },
      "description": "Chunked Base64 file attachment payload belonging to a DailyReport."
    },
    "/issues/{issueId}": {
      "schema": { "$ref": "#/entities/IssueReport" },
      "description": "Site issues and blockers."
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/ProjectTask" },
      "description": "Tasks assigned to project sites."
    },
    "/tasks/{taskId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/TaskAttachmentChunk" },
      "description": "Temporary 48-hour chunked Base64 attachment payloads uploaded by Admin for a ProjectTask."
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Official DC announcements."
    },
    "/executedWorks/{workId}": {
      "schema": { "$ref": "#/entities/ExecutedWork" },
      "description": "Site executed construction works logs."
    },
    "/executedWorks/{workId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/ReportAttachmentChunk" },
      "description": "Chunked Base64 daily report attachment payload (image, PDF, or Excel) belonging to an ExecutedWork."
    },
    "/siteDeliverables/{deliverableId}": {
      "schema": { "$ref": "#/entities/SiteDeliverable" },
      "description": "Temporary 48-hour PDF deliverables sent from site engineers to Document Control."
    },
    "/siteDeliverables/{deliverableId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/SiteDeliverableChunk" },
      "description": "Chunked Base64 PDF payload for a SiteDeliverable."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/AppNotification" },
      "description": "Real-time in-app and browser push notifications between site engineers and management."
    },
    "/appSettings/{settingId}": {
      "schema": { "$ref": "#/entities/AppBrandingSettings" },
      "description": "Global application settings such as custom Brand Color readable by all active users and writable only by admins."
    },
    "/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLogEntry" },
      "description": "Immutable admin-readable audit log of edits and status changes on Daily Reports and Project Tasks."
    },
    "/excelLogs/{logId}": {
      "schema": { "$ref": "#/entities/SharedExcelLogFile" },
      "description": "Cloud-synced project Excel log workbooks shared automatically between site engineers and admins."
    },
    "/excelLogs/{logId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/SharedExcelLogChunk" },
      "description": "Chunked Base64 payload of a SharedExcelLogFile."
    }
  }
}
