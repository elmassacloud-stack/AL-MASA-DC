rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'elmassacloud@gmail.com';
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userDocExists() {
      return isSignedIn() && exists(userDocPath(request.auth.uid));
    }

    function currentUserData() {
      return get(userDocPath(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isSuperAdmin() || (userDocExists() && currentUserData().status == 'active');
    }

    function isAdmin() {
      return isSuperAdmin() || (isActiveUser() && currentUserData().role == 'admin');
    }

    function hasProjectAccess(projectId) {
      return isAdmin() || (
        isActiveUser() &&
        (currentUserData().allProjects == true || projectId in currentUserData().assignedProjects)
      );
    }

    function hasExecutedWorksAccess() {
      return isAdmin() || (
        isActiveUser() &&
        (!('canAccessExecutedWorks' in currentUserData()) || currentUserData().canAccessExecutedWorks == true)
      );
    }

    function hasSiteDeliverablesAccess() {
      return isAdmin() || (
        isActiveUser() &&
        (!('canAccessSiteDeliverables' in currentUserData()) || currentUserData().canAccessSiteDeliverables == true)
      );
    }

    function isValidNotificationPreferences(prefs) {
      return prefs is map
        && prefs.keys().hasAll(['dailyReports', 'tasks', 'urgentTasksOnly', 'issues', 'urgentIssuesOnly', 'deliverables', 'executedWorks', 'announcements'])
        && prefs.keys().hasOnly(['dailyReports', 'tasks', 'urgentTasksOnly', 'issues', 'urgentIssuesOnly', 'deliverables', 'executedWorks', 'announcements'])
        && prefs.dailyReports is bool
        && prefs.tasks is bool
        && prefs.urgentTasksOnly is bool
        && prefs.issues is bool
        && prefs.urgentIssuesOnly is bool
        && prefs.deliverables is bool
        && prefs.executedWorks is bool
        && prefs.announcements is bool;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'role', 'assignedProjects', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'email', 'displayName', 'jobTitle', 'role', 'allProjects', 'canAccessExecutedWorks', 'canAccessSiteDeliverables', 'assignedProjects', 'status', 'phone', 'notificationPreferences', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 150
        && (!('jobTitle' in data) || (data.jobTitle is string && data.jobTitle.size() <= 150))
        && (data.role == 'admin' || data.role == 'site')
        && (!('allProjects' in data) || data.allProjects is bool)
        && (!('canAccessExecutedWorks' in data) || data.canAccessExecutedWorks is bool)
        && (!('canAccessSiteDeliverables' in data) || data.canAccessSiteDeliverables is bool)
        && data.assignedProjects is list && data.assignedProjects.size() <= 100
        && (data.status == 'active' || data.status == 'disabled')
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('notificationPreferences' in data) || isValidNotificationPreferences(data.notificationPreferences))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'name', 'code', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'code', 'description', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 80
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (data.status == 'active' || data.status == 'completed')
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidDailyReport(data) {
      return data.keys().hasAll(['id', 'projectId', 'projectName', 'reportDate', 'senderId', 'senderName', 'senderEmail', 'submittedWorks', 'receivedWorks', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'projectId', 'projectName', 'reportDate', 'senderId', 'senderName', 'senderEmail', 'submittedWorks', 'receivedWorks', 'notes', 'attachments', 'status', 'adminFeedback', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.projectId)
        && data.projectName is string && data.projectName.size() <= 200
        && data.reportDate is string && data.reportDate.size() <= 20
        && data.senderId is string && data.senderId.size() <= 128
        && data.senderName is string && data.senderName.size() <= 150
        && data.senderEmail is string && data.senderEmail.size() <= 200
        && data.submittedWorks is list && data.submittedWorks.size() <= 200
        && data.receivedWorks is list && data.receivedWorks.size() <= 200
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 4000))
        && (!('attachments' in data) || (data.attachments is list && data.attachments.size() <= 20))
        && (data.status == 'submitted' || data.status == 'reviewed' || data.status == 'needs_revision')
        && (!('adminFeedback' in data) || (data.adminFeedback is string && data.adminFeedback.size() <= 2000))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidIssueReport(data) {
      return data.keys().hasAll(['id', 'issueNumber', 'projectId', 'projectName', 'authorId', 'authorName', 'type', 'priority', 'description', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'issueNumber', 'projectId', 'projectName', 'authorId', 'authorName', 'type', 'priority', 'description', 'photoUrl', 'status', 'adminComment', 'resolvedAt', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.issueNumber is string && data.issueNumber.size() <= 40
        && isValidId(data.projectId)
        && data.projectName is string && data.projectName.size() <= 200
        && data.authorId is string && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() <= 150
        && data.type in ['equipment', 'network', 'electrical_ac', 'documents_archive', 'other']
        && (data.priority == 'normal' || data.priority == 'urgent')
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 4000
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 900000))
        && data.status in ['new', 'in_progress', 'resolved']
        && (!('adminComment' in data) || (data.adminComment is string && data.adminComment.size() <= 2000))
        && (!('resolvedAt' in data) || (data.resolvedAt is string && data.resolvedAt.size() <= 64))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidProjectTask(data) {
      return data.keys().hasAll(['id', 'projectId', 'projectName', 'title', 'description', 'deadline', 'priority', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'projectId', 'projectName', 'title', 'description', 'deadline', 'priority', 'status', 'createdBy', 'completedBy', 'completedAt', 'proofNote', 'proofAttachment', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.projectId)
        && data.projectName is string && data.projectName.size() <= 200
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.description is string && data.description.size() <= 4000
        && data.deadline is string && data.deadline.size() <= 20
        && (data.priority == 'normal' || data.priority == 'urgent')
        && data.status in ['pending', 'in_progress', 'done']
        && data.createdBy is string && data.createdBy.size() <= 128
        && (!('completedBy' in data) || (data.completedBy is string && data.completedBy.size() <= 150))
        && (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 64))
        && (!('proofNote' in data) || (data.proofNote is string && data.proofNote.size() <= 2000))
        && (!('proofAttachment' in data) || (data.proofAttachment is string && data.proofAttachment.size() <= 1000))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['id', 'title', 'content', 'targetProjects', 'isUrgent', 'createdBy', 'authorName', 'readBy', 'createdAt'])
        && data.keys().hasOnly(['id', 'title', 'content', 'targetProjects', 'isUrgent', 'createdBy', 'authorName', 'readBy', 'createdAt'])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 5000
        && data.targetProjects is list && data.targetProjects.size() <= 100
        && data.isUrgent is bool
        && data.createdBy is string && data.createdBy.size() <= 128
        && data.authorName is string && data.authorName.size() <= 150
        && data.readBy is list && data.readBy.size() <= 500
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidExecutedWork(data) {
      return data.keys().hasAll(['id', 'projectId', 'projectName', 'workDate', 'workDescription', 'discipline', 'completionPercent', 'authorId', 'authorName', 'reviewStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'projectId', 'projectName', 'workDate', 'workDescription', 'discipline', 'locationArea', 'quantity', 'unit', 'completionPercent', 'relatedSubmittalNumber', 'notes', 'authorId', 'authorName', 'reviewStatus', 'adminNote', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.projectId)
        && data.projectName is string && data.projectName.size() <= 200
        && data.workDate is string && data.workDate.size() <= 20
        && data.workDescription is string && data.workDescription.size() >= 1 && data.workDescription.size() <= 1000
        && data.discipline in ['civil_structural', 'architectural', 'electrical', 'mechanical', 'finishing', 'infrastructure', 'other']
        && (!('locationArea' in data) || (data.locationArea is string && data.locationArea.size() <= 200))
        && (!('quantity' in data) || (data.quantity is number && data.quantity >= 0 && data.quantity <= 1000000000))
        && (!('unit' in data) || (data.unit is string && data.unit.size() <= 40))
        && data.completionPercent is number && data.completionPercent >= 0 && data.completionPercent <= 100
        && (!('relatedSubmittalNumber' in data) || (data.relatedSubmittalNumber is string && data.relatedSubmittalNumber.size() <= 120))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && data.authorId is string && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() <= 150
        && data.reviewStatus in ['pending', 'approved']
        && (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 1000))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidSiteDeliverable(data) {
      return data.keys().hasAll(['id', 'projectId', 'projectName', 'title', 'deliverableType', 'fileName', 'fileSizeBytes', 'chunkCount', 'senderId', 'senderName', 'senderEmail', 'status', 'createdAt', 'updatedAt', 'expiresAt', 'expiresAtMs'])
        && data.keys().hasOnly(['id', 'projectId', 'projectName', 'title', 'deliverableType', 'submittalNumber', 'rev', 'notes', 'fileName', 'fileFormat', 'mimeType', 'fileSizeBytes', 'chunkCount', 'pageCount', 'senderId', 'senderName', 'senderEmail', 'status', 'adminNote', 'receivedAt', 'createdAt', 'updatedAt', 'expiresAt', 'expiresAtMs'])
        && isValidId(data.id)
        && isValidId(data.projectId)
        && data.projectName is string && data.projectName.size() <= 200
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.deliverableType in ['ir', 'mir', 'shop_drawing', 'handover', 'other']
        && (!('submittalNumber' in data) || (data.submittalNumber is string && data.submittalNumber.size() <= 120))
        && (!('rev' in data) || (data.rev is number && data.rev >= 0 && data.rev <= 999))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 260
        && (!('fileFormat' in data) || data.fileFormat in ['pdf', 'excel'])
        && (!('mimeType' in data) || (data.mimeType is string && data.mimeType.size() <= 150))
        && data.fileSizeBytes is int && data.fileSizeBytes >= 1 && data.fileSizeBytes <= 26500000
        && data.chunkCount is int && data.chunkCount >= 1 && data.chunkCount <= 60
        && (!('pageCount' in data) || (data.pageCount is int && data.pageCount >= 1 && data.pageCount <= 500))
        && data.senderId is string && data.senderId.size() <= 128
        && data.senderName is string && data.senderName.size() <= 150
        && data.senderEmail is string && data.senderEmail.size() <= 200
        && data.status in ['pending_receipt', 'received', 'needs_revision']
        && (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 1000))
        && (!('receivedAt' in data) || (data.receivedAt is string && data.receivedAt.size() <= 64))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.expiresAt is string && data.expiresAt.size() <= 64
        && data.expiresAtMs is int && data.expiresAtMs > 0;
    }

    function isValidSiteDeliverableChunk(data) {
      return data.keys().hasAll(['index', 'data', 'expiresAtMs'])
        && data.keys().hasOnly(['index', 'data', 'expiresAtMs'])
        && data.index is int && data.index >= 0 && data.index < 60
        && data.data is string && data.data.size() >= 1 && data.data.size() <= 800000
        && data.expiresAtMs is int && data.expiresAtMs > 0;
    }

    function isValidAppNotification(data) {
      return data.keys().hasAll(['id', 'title', 'message', 'type', 'isRead', 'createdAt'])
        && data.keys().hasOnly(['id', 'title', 'message', 'type', 'priority', 'linkTab', 'targetRole', 'targetUserId', 'projectId', 'senderId', 'senderName', 'readBy', 'isRead', 'createdAt'])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 1500
        && data.type in ['urgent_issue', 'issue_reported', 'missing_report', 'task_assigned', 'announcement', 'status_alert', 'report_submitted', 'report_reviewed', 'issue_status', 'task_done', 'work_logged', 'deliverable_sent', 'deliverable_reviewed']
        && (!('priority' in data) || (data.priority == 'normal' || data.priority == 'urgent'))
        && (!('linkTab' in data) || (data.linkTab is string && data.linkTab.size() <= 64))
        && (!('targetRole' in data) || data.targetRole in ['admin', 'site', 'all'])
        && (!('targetUserId' in data) || (data.targetUserId is string && data.targetUserId.size() <= 128))
        && (!('projectId' in data) || isValidId(data.projectId))
        && (!('senderId' in data) || (data.senderId is string && data.senderId.size() <= 128))
        && (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 150))
        && (!('readBy' in data) || (data.readBy is list && data.readBy.size() <= 500))
        && data.isRead is bool
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Users collection (PII isolated to owner or Admin)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isAdmin() || (isSignedIn() && request.auth.uid == userId));
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isAdmin() && isValidUserProfile(incoming());
      allow update: if isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (
            isSignedIn()
            && request.auth.uid == userId
            && isActiveUser()
            && incoming().diff(existing()).affectedKeys().hasOnly(['notificationPreferences', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin() && existing().email != 'elmassacloud@gmail.com';
    }

    // Projects collection
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && hasProjectAccess(projectId);
      allow list: if isAdmin() || (isActiveUser() && (currentUserData().allProjects == true || resource.data.id in currentUserData().assignedProjects));
      allow create: if isValidId(projectId) && isAdmin() && isValidProject(incoming());
      allow update: if isValidId(projectId) && isAdmin() && isValidProject(incoming())
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(projectId) && isAdmin();
    }

    // Daily Reports collection
    match /reports/{reportId} {
      allow get: if isValidId(reportId) && hasProjectAccess(existing().projectId);
      allow list: if isAdmin() || (isActiveUser() && (currentUserData().allProjects == true || resource.data.projectId in currentUserData().assignedProjects));
      allow create: if isValidId(reportId)
        && isValidDailyReport(incoming())
        && hasProjectAccess(incoming().projectId)
        && (isAdmin() || incoming().senderId == request.auth.uid)
        && incoming().status == 'submitted';
      allow update: if isValidId(reportId)
        && isAdmin()
        && isValidDailyReport(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminFeedback', 'updatedAt']);
      allow delete: if isValidId(reportId) && isAdmin();
    }

    // Issue Reports collection
    match /issues/{issueId} {
      allow get: if isValidId(issueId) && hasProjectAccess(existing().projectId);
      allow list: if isAdmin() || (isActiveUser() && (currentUserData().allProjects == true || resource.data.projectId in currentUserData().assignedProjects));
      allow create: if isValidId(issueId)
        && isValidIssueReport(incoming())
        && hasProjectAccess(incoming().projectId)
        && (isAdmin() || incoming().authorId == request.auth.uid)
        && incoming().status == 'new';
      allow update: if isValidId(issueId)
        && isAdmin()
        && isValidIssueReport(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminComment', 'resolvedAt', 'updatedAt']);
      allow delete: if isValidId(issueId) && isAdmin();
    }

    // Project Tasks collection
    match /tasks/{taskId} {
      allow get: if isValidId(taskId) && hasProjectAccess(existing().projectId);
      allow list: if isAdmin() || (isActiveUser() && (currentUserData().allProjects == true || resource.data.projectId in currentUserData().assignedProjects));
      allow create: if isValidId(taskId) && isAdmin() && isValidProjectTask(incoming());
      allow update: if isValidId(taskId)
        && isValidProjectTask(incoming())
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (
            hasProjectAccess(existing().projectId)
            && incoming().projectId == existing().projectId
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedBy', 'completedAt', 'proofNote', 'proofAttachment', 'updatedAt'])
          )
        );
      allow delete: if isValidId(taskId) && isAdmin();
    }

    // Announcements collection
    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && isActiveUser();
      allow list: if isAdmin() || isActiveUser();
      allow create: if isValidId(announcementId) && isAdmin() && isValidAnnouncement(incoming());
      allow update: if isValidId(announcementId)
        && isValidAnnouncement(incoming())
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (
            isActiveUser()
            && incoming().diff(existing()).affectedKeys().hasOnly(['readBy'])
          )
        );
      allow delete: if isValidId(announcementId) && isAdmin();
    }

    // Executed Works collection
    match /executedWorks/{workId} {
      allow get: if isValidId(workId) && hasExecutedWorksAccess() && hasProjectAccess(existing().projectId);
      allow list: if isAdmin() || (hasExecutedWorksAccess() && (currentUserData().allProjects == true || resource.data.projectId in currentUserData().assignedProjects));
      allow create: if isValidId(workId)
        && isValidExecutedWork(incoming())
        && hasExecutedWorksAccess()
        && hasProjectAccess(incoming().projectId)
        && (isAdmin() || incoming().authorId == request.auth.uid)
        && (isAdmin() || incoming().reviewStatus == 'pending');
      allow update: if isValidId(workId)
        && isValidExecutedWork(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().projectId == existing().projectId
        && (
          isAdmin() ||
          (
            hasExecutedWorksAccess()
            && hasProjectAccess(existing().projectId)
            && existing().authorId == request.auth.uid
            && existing().reviewStatus == 'pending'
            && incoming().authorId == existing().authorId
            && incoming().reviewStatus == 'pending'
          )
        );
      allow delete: if isValidId(workId) && (
        isAdmin() ||
        (hasExecutedWorksAccess() && hasProjectAccess(existing().projectId) && existing().authorId == request.auth.uid && existing().reviewStatus == 'pending')
      );
    }

    // Site PDF Deliverables (48-hour retention)
    match /siteDeliverables/{deliverableId} {
      allow get: if isValidId(deliverableId) && hasSiteDeliverablesAccess() && hasProjectAccess(existing().projectId);
      allow list: if isAdmin() || (hasSiteDeliverablesAccess() && (currentUserData().allProjects == true || resource.data.projectId in currentUserData().assignedProjects));
      allow create: if isValidId(deliverableId)
        && isValidSiteDeliverable(incoming())
        && hasSiteDeliverablesAccess()
        && hasProjectAccess(incoming().projectId)
        && exists(/databases/$(database)/documents/projects/$(incoming().projectId))
        && (isAdmin() || incoming().senderId == request.auth.uid)
        && (isAdmin() || incoming().status == 'pending_receipt');
      allow update: if isValidId(deliverableId)
        && isAdmin()
        && isValidSiteDeliverable(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().projectId == existing().projectId
        && incoming().senderId == existing().senderId
        && incoming().expiresAtMs == existing().expiresAtMs
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'receivedAt', 'updatedAt']);
      allow delete: if isValidId(deliverableId) && (
        isAdmin() ||
        (hasSiteDeliverablesAccess() && hasProjectAccess(existing().projectId) && existing().senderId == request.auth.uid) ||
        (isActiveUser() && existing().expiresAtMs is int && existing().expiresAtMs <= request.time.toMillis())
      );

      match /chunks/{chunkId} {
        allow get: if isValidId(deliverableId)
          && isValidId(chunkId)
          && exists(/databases/$(database)/documents/siteDeliverables/$(deliverableId))
          && hasSiteDeliverablesAccess()
          && hasProjectAccess(get(/databases/$(database)/documents/siteDeliverables/$(deliverableId)).data.projectId);
        allow list: if isValidId(deliverableId)
          && exists(/databases/$(database)/documents/siteDeliverables/$(deliverableId))
          && hasSiteDeliverablesAccess()
          && hasProjectAccess(get(/databases/$(database)/documents/siteDeliverables/$(deliverableId)).data.projectId);
        allow create: if isValidId(deliverableId)
          && isValidId(chunkId)
          && isValidSiteDeliverableChunk(incoming())
          && exists(/databases/$(database)/documents/siteDeliverables/$(deliverableId))
          && hasSiteDeliverablesAccess()
          && hasProjectAccess(get(/databases/$(database)/documents/siteDeliverables/$(deliverableId)).data.projectId)
          && (isAdmin() || get(/databases/$(database)/documents/siteDeliverables/$(deliverableId)).data.senderId == request.auth.uid);
        allow delete: if isValidId(deliverableId) && isValidId(chunkId) && (
          isAdmin() ||
          (isActiveUser() && existing().expiresAtMs is int && existing().expiresAtMs <= request.time.toMillis()) ||
          (
            exists(/databases/$(database)/documents/siteDeliverables/$(deliverableId))
            && hasSiteDeliverablesAccess()
            && hasProjectAccess(get(/databases/$(database)/documents/siteDeliverables/$(deliverableId)).data.projectId)
            && get(/databases/$(database)/documents/siteDeliverables/$(deliverableId)).data.senderId == request.auth.uid
          )
        );
      }
    }

    // Real-time Notifications collection
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && (
        isAdmin() ||
        (
          isActiveUser() &&
          (
            existing().targetUserId == request.auth.uid ||
            existing().targetRole in ['site', 'all']
          )
        )
      );
      allow list: if isAdmin() || (
        isActiveUser() &&
        (
          resource.data.targetUserId == request.auth.uid ||
          resource.data.targetRole in ['site', 'all']
        )
      );
      allow create: if isValidId(notificationId)
        && isValidAppNotification(incoming())
        && isActiveUser()
        && (
          isAdmin() ||
          (
            incoming().targetRole == 'admin'
            && incoming().senderId == request.auth.uid
            && incoming().type in ['report_submitted', 'urgent_issue', 'issue_reported', 'deliverable_sent', 'work_logged', 'task_done']
            && (!('projectId' in incoming()) || hasProjectAccess(incoming().projectId))
          )
        );
      allow update: if isValidId(notificationId)
        && isValidAppNotification(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['readBy', 'isRead'])
        && (
          isAdmin() ||
          (
            isActiveUser() &&
            (
              existing().targetUserId == request.auth.uid ||
              existing().targetRole in ['site', 'all']
            )
          )
        );
      allow delete: if isValidId(notificationId) && isAdmin();
    }
  }
}
