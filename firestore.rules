rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && ('email' in request.auth.token)
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'elmassacloud@gmail.com';
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userDocExists() {
      return isSignedIn() && exists(userDocPath(request.auth.uid));
    }

    function currentUserData() {
      return get(userDocPath(request.auth.uid)).data;
    }

    // Pure in-memory helpers evaluated against a single fetched user document map `u`
    // (guarantees at most 1 exists() + 1 get() per request to stay well under Firestore's 10-call limit)
    function userDataIsActive(u) {
      return !('status' in u) || u.status != 'disabled';
    }

    function userDataIsAdmin(u) {
      return userDataIsActive(u) && 'role' in u && u.role == 'admin';
    }

    function userDataHasAllProjects(u) {
      return 'allProjects' in u && u.allProjects == true;
    }

    function userDataHasAssignedProject(u, projectId) {
      return 'assignedProjects' in u
        && u.assignedProjects is list
        && projectId in u.assignedProjects;
    }

    function userDataHasProjectAccess(u, projectId) {
      return userDataIsAdmin(u) || (
        userDataIsActive(u) &&
        (userDataHasAllProjects(u) || userDataHasAssignedProject(u, projectId))
      );
    }

    function userDataHasExecutedWorksAccess(u) {
      return userDataIsAdmin(u) || (
        userDataIsActive(u) &&
        (!('canAccessExecutedWorks' in u) || u.canAccessExecutedWorks != false)
      );
    }

    function userDataIsReportOwner(u, reportData) {
      return ('senderId' in reportData && reportData.senderId == request.auth.uid) || (
        'senderEmail' in reportData &&
        reportData.senderEmail is string && (
          ('email' in u && u.email is string && reportData.senderEmail.lower() == u.email.lower()) ||
          ('email' in request.auth.token && request.auth.token.email is string && reportData.senderEmail.lower() == request.auth.token.email.lower())
        )
      );
    }

    // Single-fetch wrapper helpers (max 1 exists + 1 get each)
    function isActiveUser() {
      return isSuperAdmin() || (userDocExists() && userDataIsActive(currentUserData()));
    }

    function isAdmin() {
      return isSuperAdmin() || (userDocExists() && userDataIsAdmin(currentUserData()));
    }

    function hasProjectAccess(projectId) {
      return isSuperAdmin() || (userDocExists() && userDataHasProjectAccess(currentUserData(), projectId));
    }

    // Composite single-fetch permission gates (prevent repeated get() calls per rule)
    function userDataCanUpdateUser(u, userId, inc, ext) {
      return userDataIsAdmin(u) || (
        request.auth.uid == userId
        && userDataIsActive(u)
        && inc.diff(ext).affectedKeys().hasOnly(['notificationPreferences', 'updatedAt'])
      );
    }

    function canUpdateUser(userId, inc, ext) {
      return isSuperAdmin() || (userDocExists() && userDataCanUpdateUser(currentUserData(), userId, inc, ext));
    }

    function userDataCanGetReport(u, res) {
      return userDataIsAdmin(u) || (
        userDataIsActive(u) && (
          res == null ||
          userDataHasProjectAccess(u, res.data.projectId) ||
          userDataIsReportOwner(u, res.data)
        )
      );
    }

    function canGetReport(res) {
      return isSuperAdmin() || (userDocExists() && userDataCanGetReport(currentUserData(), res));
    }

    function userDataCanCreateReport(u, reportId, inc) {
      return userDataIsAdmin(u) || (
        userDataHasProjectAccess(u, inc.projectId)
        && inc.senderId == request.auth.uid
        && reportId == 'rep-' + inc.projectId + '-' + inc.reportDate
      );
    }

    function canCreateReport(reportId, inc) {
      return isSuperAdmin() || (userDocExists() && userDataCanCreateReport(currentUserData(), reportId, inc));
    }

    function userDataCanUpdateReport(u, inc, ext) {
      return userDataIsAdmin(u) || (
        userDataIsActive(u)
        && (
          (
            userDataIsReportOwner(u, ext)
            && (
              (userDataHasProjectAccess(u, ext.projectId) && userDataHasProjectAccess(u, inc.projectId)) ||
              inc.projectId == ext.projectId
            )
          ) ||
          (
            userDataHasProjectAccess(u, ext.projectId)
            && userDataHasProjectAccess(u, inc.projectId)
          )
        )
        && (!('senderId' in ext) || inc.senderId == ext.senderId)
        && (!('senderEmail' in ext) || inc.senderEmail == ext.senderEmail)
        && inc.status == 'submitted'
        && inc.diff(ext).affectedKeys().hasOnly([
          'projectId',
          'projectName',
          'reportDate',
          'submittedWorks',
          'receivedWorks',
          'notes',
          'attachments',
          'status',
          'updatedAt'
        ])
      );
    }

    function canUpdateReport(inc, ext) {
      return isSuperAdmin() || (userDocExists() && userDataCanUpdateReport(currentUserData(), inc, ext));
    }

    function userDataCanAccessReportDoc(u, repData) {
      return userDataIsAdmin(u) || (
        userDataIsActive(u) && (
          userDataHasProjectAccess(u, repData.projectId) ||
          userDataIsReportOwner(u, repData)
        )
      );
    }

    function canAccessReportChunks(reportId) {
      return exists(/databases/$(database)/documents/reports/$(reportId)) && (
        isSuperAdmin() || (
          userDocExists() &&
          userDataCanAccessReportDoc(
            currentUserData(),
            get(/databases/$(database)/documents/reports/$(reportId)).data
          )
        )
      );
    }

    function canDeleteReportChunk(reportId) {
      return isSuperAdmin() || (
        userDocExists() && (
          userDataIsAdmin(currentUserData()) || (
            exists(/databases/$(database)/documents/reports/$(reportId)) &&
            userDataCanAccessReportDoc(
              currentUserData(),
              get(/databases/$(database)/documents/reports/$(reportId)).data
            )
          )
        )
      );
    }

    function userDataCanCreateIssue(u, inc) {
      return userDataIsAdmin(u) || (
        userDataHasProjectAccess(u, inc.projectId) &&
        inc.authorId == request.auth.uid
      );
    }

    function canCreateIssue(inc) {
      return isSuperAdmin() || (userDocExists() && userDataCanCreateIssue(currentUserData(), inc));
    }

    function userDataCanUpdateTask(u, inc, ext) {
      return userDataIsAdmin(u) || (
        userDataHasProjectAccess(u, ext.projectId)
        && inc.projectId == ext.projectId
        && inc.diff(ext).affectedKeys().hasOnly(['status', 'completedBy', 'completedAt', 'proofNote', 'proofAttachment', 'updatedAt'])
      );
    }

    function canUpdateTask(inc, ext) {
      return isSuperAdmin() || (userDocExists() && userDataCanUpdateTask(currentUserData(), inc, ext));
    }

    function userDataCanDeleteTaskChunk(u, ext) {
      return userDataIsAdmin(u) || (
        userDataIsActive(u) && ext.expiresAtMs is int && ext.expiresAtMs <= request.time.toMillis()
      );
    }

    function canDeleteTaskChunk(ext) {
      return isSuperAdmin() || (userDocExists() && userDataCanDeleteTaskChunk(currentUserData(), ext));
    }

    function userDataCanUpdateAnnouncement(u, inc, ext) {
      return userDataIsAdmin(u) || (
        userDataIsActive(u) &&
        inc.diff(ext).affectedKeys().hasOnly(['readBy'])
      );
    }

    function canUpdateAnnouncement(inc, ext) {
      return isSuperAdmin() || (userDocExists() && userDataCanUpdateAnnouncement(currentUserData(), inc, ext));
    }

    function userDataCanReadExecutedWork(u, projectId) {
      return userDataIsAdmin(u) || (
        userDataHasExecutedWorksAccess(u) &&
        userDataHasProjectAccess(u, projectId)
      );
    }

    function canReadExecutedWork(projectId) {
      return isSuperAdmin() || (userDocExists() && userDataCanReadExecutedWork(currentUserData(), projectId));
    }

    function userDataCanCreateExecutedWork(u, inc) {
      return userDataIsAdmin(u) || (
        userDataHasExecutedWorksAccess(u)
        && userDataHasProjectAccess(u, inc.projectId)
        && inc.authorId == request.auth.uid
        && inc.reviewStatus == 'pending'
      );
    }

    function canCreateExecutedWork(inc) {
      return isSuperAdmin() || (userDocExists() && userDataCanCreateExecutedWork(currentUserData(), inc));
    }

    function userDataCanUpdateExecutedWork(u, inc, ext) {
      return userDataIsAdmin(u) || (
        userDataHasExecutedWorksAccess(u)
        && userDataHasProjectAccess(u, ext.projectId)
        && ext.authorId == request.auth.uid
        && ext.reviewStatus == 'pending'
        && inc.authorId == ext.authorId
        && inc.reviewStatus == 'pending'
      );
    }

    function canUpdateExecutedWork(inc, ext) {
      return isSuperAdmin() || (userDocExists() && userDataCanUpdateExecutedWork(currentUserData(), inc, ext));
    }

    function userDataCanDeleteExecutedWork(u, ext) {
      return userDataIsAdmin(u) || (
        userDataHasExecutedWorksAccess(u)
        && userDataHasProjectAccess(u, ext.projectId)
        && ext.authorId == request.auth.uid
        && ext.reviewStatus == 'pending'
      );
    }

    function canDeleteExecutedWork(ext) {
      return isSuperAdmin() || (userDocExists() && userDataCanDeleteExecutedWork(currentUserData(), ext));
    }

    function userDataCanReadDeliverableData(u, delData) {
      return userDataIsAdmin(u) || (
        userDataIsActive(u) && (
          delData.senderId == request.auth.uid ||
          userDataHasProjectAccess(u, delData.projectId)
        )
      );
    }

    function canReadDeliverableData(delData) {
      return isSuperAdmin() || (userDocExists() && userDataCanReadDeliverableData(currentUserData(), delData));
    }

    function userDataCanCreateDeliverable(u, inc) {
      return userDataIsAdmin(u) || (
        userDataIsActive(u)
        && inc.senderId == request.auth.uid
        && inc.status == 'pending_receipt'
      );
    }

    function canCreateDeliverable(inc) {
      return isSuperAdmin() || (userDocExists() && userDataCanCreateDeliverable(currentUserData(), inc));
    }

    function userDataCanDeleteDeliverable(u, ext) {
      return userDataIsAdmin(u) || (
        userDataIsActive(u) && (
          ext.senderId == request.auth.uid ||
          (ext.expiresAtMs is int && ext.expiresAtMs <= request.time.toMillis())
        )
      );
    }

    function canDeleteDeliverable(ext) {
      return isSuperAdmin() || (userDocExists() && userDataCanDeleteDeliverable(currentUserData(), ext));
    }

    function canReadDeliverableChunks(deliverableId) {
      return exists(/databases/$(database)/documents/siteDeliverables/$(deliverableId)) && (
        isSuperAdmin() || (
          userDocExists() &&
          userDataCanReadDeliverableData(
            currentUserData(),
            get(/databases/$(database)/documents/siteDeliverables/$(deliverableId)).data
          )
        )
      );
    }

    function userDataCanCreateDeliverableChunk(u, delData) {
      return userDataIsAdmin(u) || (
        userDataIsActive(u) && delData.senderId == request.auth.uid
      );
    }

    function canCreateDeliverableChunk(deliverableId) {
      return exists(/databases/$(database)/documents/siteDeliverables/$(deliverableId)) && (
        isSuperAdmin() || (
          userDocExists() &&
          userDataCanCreateDeliverableChunk(
            currentUserData(),
            get(/databases/$(database)/documents/siteDeliverables/$(deliverableId)).data
          )
        )
      );
    }

    function userDataCanDeleteDeliverableChunk(u, deliverableId, ext) {
      return userDataIsAdmin(u) || (
        userDataIsActive(u) && (
          (ext.expiresAtMs is int && ext.expiresAtMs <= request.time.toMillis()) || (
            exists(/databases/$(database)/documents/siteDeliverables/$(deliverableId)) &&
            get(/databases/$(database)/documents/siteDeliverables/$(deliverableId)).data.senderId == request.auth.uid
          )
        )
      );
    }

    function canDeleteDeliverableChunk(deliverableId, ext) {
      return isSuperAdmin() || (userDocExists() && userDataCanDeleteDeliverableChunk(currentUserData(), deliverableId, ext));
    }

    function userDataCanReadNotification(u, notifData) {
      return userDataIsAdmin(u) || (
        userDataIsActive(u) && (
          notifData.targetUserId == request.auth.uid ||
          notifData.targetRole in ['site', 'all']
        )
      );
    }

    function canReadNotification(notifData) {
      return isSuperAdmin() || (userDocExists() && userDataCanReadNotification(currentUserData(), notifData));
    }

    function userDataCanCreateNotification(u, inc) {
      return userDataIsAdmin(u) || (
        userDataIsActive(u)
        && inc.targetRole == 'admin'
        && inc.senderId == request.auth.uid
        && inc.type in ['report_submitted', 'urgent_issue', 'issue_reported', 'deliverable_sent', 'work_logged', 'task_done']
        && (
          inc.type == 'deliverable_sent' ||
          !('projectId' in inc) ||
          userDataHasProjectAccess(u, inc.projectId)
        )
      );
    }

    function canCreateNotification(inc) {
      return isSuperAdmin() || (userDocExists() && userDataCanCreateNotification(currentUserData(), inc));
    }

    // Schema validation blueprints (pure, 0 DB calls)
    function isValidNotificationPreferences(prefs) {
      return prefs is map
        && prefs.keys().hasAll(['dailyReports', 'tasks', 'urgentTasksOnly', 'issues', 'urgentIssuesOnly', 'deliverables', 'executedWorks', 'announcements'])
        && prefs.keys().hasOnly(['dailyReports', 'tasks', 'urgentTasksOnly', 'issues', 'urgentIssuesOnly', 'deliverables', 'executedWorks', 'announcements'])
        && prefs.dailyReports is bool
        && prefs.tasks is bool
        && prefs.urgentTasksOnly is bool
        && prefs.issues is bool
        && prefs.urgentIssuesOnly is bool
        && prefs.deliverables is bool
        && prefs.executedWorks is bool
        && prefs.announcements is bool;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'role', 'assignedProjects', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'email', 'displayName', 'jobTitle', 'role', 'allProjects', 'canAccessExecutedWorks', 'canAccessSiteDeliverables', 'assignedProjects', 'status', 'phone', 'notificationPreferences', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 150
        && (!('jobTitle' in data) || (data.jobTitle is string && data.jobTitle.size() <= 150))
        && (data.role == 'admin' || data.role == 'site')
        && (!('allProjects' in data) || data.allProjects is bool)
        && (!('canAccessExecutedWorks' in data) || data.canAccessExecutedWorks is bool)
        && (!('canAccessSiteDeliverables' in data) || data.canAccessSiteDeliverables is bool)
        && data.assignedProjects is list && data.assignedProjects.size() <= 100
        && (data.status == 'active' || data.status == 'disabled')
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('notificationPreferences' in data) || isValidNotificationPreferences(data.notificationPreferences))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'name', 'code', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'code', 'description', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 80
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (data.status == 'active' || data.status == 'completed')
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidDailyReport(data) {
      return data.keys().hasAll(['id', 'projectId', 'projectName', 'reportDate', 'senderId', 'senderName', 'senderEmail', 'submittedWorks', 'receivedWorks', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'projectId', 'projectName', 'reportDate', 'senderId', 'senderName', 'senderEmail', 'submittedWorks', 'receivedWorks', 'notes', 'attachments', 'status', 'adminFeedback', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.projectId)
        && data.projectName is string && data.projectName.size() <= 200
        && data.reportDate is string && data.reportDate.size() <= 20
        && data.senderId is string && data.senderId.size() <= 128
        && data.senderName is string && data.senderName.size() <= 150
        && data.senderEmail is string && data.senderEmail.size() <= 200
        && data.submittedWorks is list && data.submittedWorks.size() <= 200
        && (data.submittedWorks.size() == 0 || data.submittedWorks[0] is map)
        && data.receivedWorks is list && data.receivedWorks.size() <= 200
        && (data.receivedWorks.size() == 0 || data.receivedWorks[0] is map)
        && (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 4000))
        && (!('attachments' in data) || data.attachments == null || (data.attachments is list && data.attachments.size() <= 5 && (data.attachments.size() == 0 || data.attachments[0] is map)))
        && (data.status == 'submitted' || data.status == 'reviewed' || data.status == 'needs_revision')
        && (!('adminFeedback' in data) || data.adminFeedback == null || (data.adminFeedback is string && data.adminFeedback.size() <= 2000))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidIssueReport(data) {
      return data.keys().hasAll(['id', 'issueNumber', 'projectId', 'projectName', 'authorId', 'authorName', 'type', 'priority', 'description', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'issueNumber', 'projectId', 'projectName', 'authorId', 'authorName', 'type', 'priority', 'description', 'photoUrl', 'status', 'adminComment', 'resolvedAt', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.issueNumber is string && data.issueNumber.size() <= 40
        && isValidId(data.projectId)
        && data.projectName is string && data.projectName.size() <= 200
        && data.authorId is string && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() <= 150
        && data.type in ['equipment', 'network', 'electrical_ac', 'documents_archive', 'other']
        && (data.priority == 'normal' || data.priority == 'urgent')
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 4000
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 900000))
        && data.status in ['new', 'in_progress', 'resolved']
        && (!('adminComment' in data) || (data.adminComment is string && data.adminComment.size() <= 2000))
        && (!('resolvedAt' in data) || (data.resolvedAt is string && data.resolvedAt.size() <= 64))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidProjectTask(data) {
      return data.keys().hasAll(['id', 'projectId', 'projectName', 'title', 'description', 'deadline', 'priority', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'projectId', 'projectName', 'title', 'description', 'deadline', 'priority', 'status', 'createdBy', 'completedBy', 'completedAt', 'proofNote', 'proofAttachment', 'attachments', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.projectId)
        && data.projectName is string && data.projectName.size() <= 200
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.description is string && data.description.size() <= 4000
        && data.deadline is string && data.deadline.size() <= 20
        && (data.priority == 'normal' || data.priority == 'urgent')
        && data.status in ['pending', 'in_progress', 'done']
        && data.createdBy is string && data.createdBy.size() <= 128
        && (!('completedBy' in data) || (data.completedBy is string && data.completedBy.size() <= 150))
        && (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 64))
        && (!('proofNote' in data) || (data.proofNote is string && data.proofNote.size() <= 2000))
        && (!('proofAttachment' in data) || (data.proofAttachment is string && data.proofAttachment.size() <= 1000))
        && (!('attachments' in data) || (
          data.attachments is list
          && data.attachments.size() <= 5
          && (
            data.attachments.size() == 0 ||
            (
              data.attachments[0] is map
              && 'id' in data.attachments[0]
              && 'expiresAtMs' in data.attachments[0]
              && data.attachments[0].expiresAtMs is int
            )
          )
        ))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidTaskAttachmentChunk(data) {
      return data.keys().hasAll(['attachmentId', 'index', 'data', 'expiresAtMs'])
        && data.keys().hasOnly(['attachmentId', 'index', 'data', 'expiresAtMs'])
        && isValidId(data.attachmentId)
        && data.index is int && data.index >= 0 && data.index < 60
        && data.data is string && data.data.size() >= 1 && data.data.size() <= 800000
        && data.expiresAtMs is int && data.expiresAtMs > 0;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['id', 'title', 'content', 'targetProjects', 'isUrgent', 'createdBy', 'authorName', 'readBy', 'createdAt'])
        && data.keys().hasOnly(['id', 'title', 'content', 'targetProjects', 'isUrgent', 'createdBy', 'authorName', 'readBy', 'createdAt'])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 5000
        && data.targetProjects is list && data.targetProjects.size() <= 100
        && data.isUrgent is bool
        && data.createdBy is string && data.createdBy.size() <= 128
        && data.authorName is string && data.authorName.size() <= 150
        && data.readBy is list && data.readBy.size() <= 500
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidExecutedWork(data) {
      return data.keys().hasAll(['id', 'projectId', 'projectName', 'workDate', 'workDescription', 'discipline', 'completionPercent', 'authorId', 'authorName', 'reviewStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'projectId', 'projectName', 'workDate', 'workDescription', 'discipline', 'locationArea', 'quantity', 'unit', 'completionPercent', 'relatedSubmittalNumber', 'notes', 'authorId', 'authorName', 'reviewStatus', 'adminNote', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.projectId)
        && data.projectName is string && data.projectName.size() <= 200
        && data.workDate is string && data.workDate.size() <= 20
        && data.workDescription is string && data.workDescription.size() >= 1 && data.workDescription.size() <= 1000
        && data.discipline in ['civil_structural', 'architectural', 'electrical', 'mechanical', 'finishing', 'infrastructure', 'other']
        && (!('locationArea' in data) || (data.locationArea is string && data.locationArea.size() <= 200))
        && (!('quantity' in data) || (data.quantity is number && data.quantity >= 0 && data.quantity <= 1000000000))
        && (!('unit' in data) || (data.unit is string && data.unit.size() <= 40))
        && data.completionPercent is number && data.completionPercent >= 0 && data.completionPercent <= 100
        && (!('relatedSubmittalNumber' in data) || (data.relatedSubmittalNumber is string && data.relatedSubmittalNumber.size() <= 120))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && data.authorId is string && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() <= 150
        && data.reviewStatus in ['pending', 'approved']
        && (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 1000))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidSiteDeliverable(data) {
      return data.keys().hasAll(['id', 'projectId', 'projectName', 'title', 'deliverableType', 'fileName', 'fileSizeBytes', 'chunkCount', 'senderId', 'senderName', 'senderEmail', 'status', 'createdAt', 'updatedAt', 'expiresAt', 'expiresAtMs'])
        && data.keys().hasOnly(['id', 'projectId', 'projectName', 'title', 'deliverableType', 'submittalNumber', 'rev', 'notes', 'fileName', 'fileFormat', 'mimeType', 'fileSizeBytes', 'chunkCount', 'pageCount', 'senderId', 'senderName', 'senderEmail', 'status', 'adminNote', 'receivedAt', 'createdAt', 'updatedAt', 'expiresAt', 'expiresAtMs'])
        && isValidId(data.id)
        && isValidId(data.projectId)
        && data.projectName is string && data.projectName.size() <= 200
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.deliverableType in ['ir', 'mir', 'shop_drawing', 'handover', 'other']
        && (!('submittalNumber' in data) || (data.submittalNumber is string && data.submittalNumber.size() <= 120))
        && (!('rev' in data) || (data.rev is number && data.rev >= 0 && data.rev <= 999))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 260
        && (!('fileFormat' in data) || data.fileFormat in ['pdf', 'excel'])
        && (!('mimeType' in data) || (data.mimeType is string && data.mimeType.size() <= 150))
        && data.fileSizeBytes is int && data.fileSizeBytes >= 1 && data.fileSizeBytes <= 26500000
        && data.chunkCount is int && data.chunkCount >= 1 && data.chunkCount <= 60
        && (!('pageCount' in data) || (data.pageCount is int && data.pageCount >= 1 && data.pageCount <= 2000))
        && data.senderId is string && data.senderId.size() <= 128
        && data.senderName is string && data.senderName.size() <= 150
        && data.senderEmail is string && data.senderEmail.size() <= 200
        && data.status in ['pending_receipt', 'received', 'needs_revision']
        && (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 1000))
        && (!('receivedAt' in data) || (data.receivedAt is string && data.receivedAt.size() <= 64))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.expiresAt is string && data.expiresAt.size() <= 64
        && data.expiresAtMs is int && data.expiresAtMs > 0;
    }

    function isValidSiteDeliverableChunk(data) {
      return data.keys().hasAll(['index', 'data', 'expiresAtMs'])
        && data.keys().hasOnly(['index', 'data', 'expiresAtMs'])
        && data.index is int && data.index >= 0 && data.index < 60
        && data.data is string && data.data.size() >= 1 && data.data.size() <= 800000
        && data.expiresAtMs is int && data.expiresAtMs > 0;
    }

    function isValidReportAttachmentChunk(data) {
      return data.keys().hasAll(['attachmentId', 'index', 'data'])
        && data.keys().hasOnly(['attachmentId', 'index', 'data'])
        && isValidId(data.attachmentId)
        && data.index is int && data.index >= 0 && data.index < 20
        && data.data is string && data.data.size() >= 1 && data.data.size() <= 800000;
    }

    function isValidAppNotification(data) {
      return data.keys().hasAll(['id', 'title', 'message', 'type', 'isRead', 'createdAt'])
        && data.keys().hasOnly(['id', 'title', 'message', 'type', 'priority', 'linkTab', 'targetRole', 'targetUserId', 'projectId', 'senderId', 'senderName', 'readBy', 'isRead', 'createdAt'])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 1500
        && data.type in ['urgent_issue', 'issue_reported', 'missing_report', 'task_assigned', 'announcement', 'status_alert', 'report_submitted', 'report_reviewed', 'issue_status', 'task_done', 'work_logged', 'deliverable_sent', 'deliverable_reviewed']
        && (!('priority' in data) || (data.priority == 'normal' || data.priority == 'urgent'))
        && (!('linkTab' in data) || (data.linkTab is string && data.linkTab.size() <= 64))
        && (!('targetRole' in data) || data.targetRole in ['admin', 'site', 'all'])
        && (!('targetUserId' in data) || (data.targetUserId is string && data.targetUserId.size() <= 128))
        && (!('projectId' in data) || isValidId(data.projectId))
        && (!('senderId' in data) || (data.senderId is string && data.senderId.size() <= 128))
        && (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 150))
        && (!('readBy' in data) || (data.readBy is list && data.readBy.size() <= 500))
        && data.isRead is bool
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Users collection (PII isolated to owner or Admin)
    match /users/{userId} {
      allow get: if isValidId(userId) && ((isSignedIn() && request.auth.uid == userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isValidUserProfile(incoming()) && isAdmin();
      allow update: if isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == existing().createdAt
        && canUpdateUser(userId, incoming(), existing());
      allow delete: if isValidId(userId) && existing().email.lower() != 'elmassacloud@gmail.com' && isAdmin();
    }

    // Projects collection
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && isActiveUser();
      allow list: if isActiveUser();
      allow create: if isValidId(projectId) && isValidProject(incoming()) && isAdmin();
      allow update: if isValidId(projectId) && isValidProject(incoming())
        && incoming().createdAt == existing().createdAt
        && isAdmin();
      allow delete: if isValidId(projectId) && isAdmin();
    }

    // Daily Reports collection
    match /reports/{reportId} {
      allow get: if isValidId(reportId) && canGetReport(resource);
      allow list: if hasProjectAccess(resource.data.projectId);
      allow create: if isValidId(reportId)
        && isValidDailyReport(incoming())
        && incoming().status == 'submitted'
        && canCreateReport(reportId, incoming());
      allow update: if isValidId(reportId)
        && isValidDailyReport(incoming())
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
        && canUpdateReport(incoming(), existing());
      allow delete: if isValidId(reportId) && isAdmin();

      match /chunks/{chunkId} {
        allow get: if isValidId(reportId)
          && isValidId(chunkId)
          && canAccessReportChunks(reportId);
        allow list: if isValidId(reportId)
          && canAccessReportChunks(reportId);
        allow create: if isValidId(reportId)
          && isValidId(chunkId)
          && isValidReportAttachmentChunk(incoming())
          && canAccessReportChunks(reportId);
        allow delete: if isValidId(reportId)
          && isValidId(chunkId)
          && canDeleteReportChunk(reportId);
      }
    }

    // Issue Reports collection
    match /issues/{issueId} {
      allow get: if isValidId(issueId) && hasProjectAccess(existing().projectId);
      allow list: if hasProjectAccess(resource.data.projectId);
      allow create: if isValidId(issueId)
        && isValidIssueReport(incoming())
        && incoming().status == 'new'
        && canCreateIssue(incoming());
      allow update: if isValidId(issueId)
        && isValidIssueReport(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminComment', 'resolvedAt', 'updatedAt'])
        && isAdmin();
      allow delete: if isValidId(issueId) && isAdmin();
    }

    // Project Tasks collection
    match /tasks/{taskId} {
      allow get: if isValidId(taskId) && hasProjectAccess(existing().projectId);
      allow list: if hasProjectAccess(resource.data.projectId);
      allow create: if isValidId(taskId) && isValidProjectTask(incoming()) && isAdmin();
      allow update: if isValidId(taskId)
        && isValidProjectTask(incoming())
        && incoming().createdAt == existing().createdAt
        && canUpdateTask(incoming(), existing());
      allow delete: if isValidId(taskId) && isAdmin();

      match /chunks/{chunkId} {
        allow get: if isValidId(taskId)
          && isValidId(chunkId)
          && exists(/databases/$(database)/documents/tasks/$(taskId))
          && hasProjectAccess(get(/databases/$(database)/documents/tasks/$(taskId)).data.projectId);
        allow list: if isValidId(taskId)
          && exists(/databases/$(database)/documents/tasks/$(taskId))
          && hasProjectAccess(get(/databases/$(database)/documents/tasks/$(taskId)).data.projectId);
        allow create: if isValidId(taskId)
          && isValidId(chunkId)
          && isValidTaskAttachmentChunk(incoming())
          && exists(/databases/$(database)/documents/tasks/$(taskId))
          && isAdmin();
        allow delete: if isValidId(taskId)
          && isValidId(chunkId)
          && canDeleteTaskChunk(existing());
      }
    }

    // Announcements collection
    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && isActiveUser();
      allow list: if isActiveUser();
      allow create: if isValidId(announcementId) && isValidAnnouncement(incoming()) && isAdmin();
      allow update: if isValidId(announcementId)
        && isValidAnnouncement(incoming())
        && incoming().createdAt == existing().createdAt
        && canUpdateAnnouncement(incoming(), existing());
      allow delete: if isValidId(announcementId) && isAdmin();
    }

    // Executed Works collection
    match /executedWorks/{workId} {
      allow get: if isValidId(workId) && canReadExecutedWork(existing().projectId);
      allow list: if canReadExecutedWork(resource.data.projectId);
      allow create: if isValidId(workId)
        && isValidExecutedWork(incoming())
        && canCreateExecutedWork(incoming());
      allow update: if isValidId(workId)
        && isValidExecutedWork(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().projectId == existing().projectId
        && canUpdateExecutedWork(incoming(), existing());
      allow delete: if isValidId(workId) && canDeleteExecutedWork(existing());
    }

    // Site PDF Deliverables (48-hour retention - upload enabled for all active authenticated emails)
    match /siteDeliverables/{deliverableId} {
      allow get: if isValidId(deliverableId) && canReadDeliverableData(existing());
      allow list: if canReadDeliverableData(resource.data);
      allow create: if isValidId(deliverableId)
        && isValidSiteDeliverable(incoming())
        && canCreateDeliverable(incoming());
      allow update: if isValidId(deliverableId)
        && isValidSiteDeliverable(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().projectId == existing().projectId
        && incoming().senderId == existing().senderId
        && incoming().expiresAtMs == existing().expiresAtMs
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'receivedAt', 'updatedAt'])
        && isAdmin();
      allow delete: if isValidId(deliverableId) && canDeleteDeliverable(existing());

      match /chunks/{chunkId} {
        allow get: if isValidId(deliverableId)
          && isValidId(chunkId)
          && canReadDeliverableChunks(deliverableId);
        allow list: if isValidId(deliverableId)
          && canReadDeliverableChunks(deliverableId);
        allow create: if isValidId(deliverableId)
          && isValidId(chunkId)
          && isValidSiteDeliverableChunk(incoming())
          && canCreateDeliverableChunk(deliverableId);
        allow delete: if isValidId(deliverableId)
          && isValidId(chunkId)
          && canDeleteDeliverableChunk(deliverableId, existing());
      }
    }

    // Real-time Notifications collection
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && canReadNotification(existing());
      allow list: if canReadNotification(resource.data);
      allow create: if isValidId(notificationId)
        && isValidAppNotification(incoming())
        && canCreateNotification(incoming());
      allow update: if isValidId(notificationId)
        && isValidAppNotification(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['readBy', 'isRead'])
        && canReadNotification(existing());
      allow delete: if isValidId(notificationId) && isAdmin();
    }
  }
}
