rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'elmassacloud@gmail.com';
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userDocExists() {
      return isSignedIn() && exists(userDocPath(request.auth.uid));
    }

    function currentUserData() {
      return get(userDocPath(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isSuperAdmin() || (userDocExists() && currentUserData().status == 'active');
    }

    function isAdmin() {
      return isSuperAdmin() || (isActiveUser() && currentUserData().role == 'admin');
    }

    function hasProjectAccess(projectId) {
      return isAdmin() || (
        isActiveUser() &&
        (currentUserData().allProjects == true || projectId in currentUserData().assignedProjects)
      );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'role', 'assignedProjects', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'email', 'displayName', 'jobTitle', 'role', 'allProjects', 'assignedProjects', 'status', 'phone', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 150
        && (!('jobTitle' in data) || (data.jobTitle is string && data.jobTitle.size() <= 150))
        && (data.role == 'admin' || data.role == 'site')
        && (!('allProjects' in data) || data.allProjects is bool)
        && data.assignedProjects is list && data.assignedProjects.size() <= 100
        && (data.status == 'active' || data.status == 'disabled')
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'name', 'code', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'code', 'description', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 80
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (data.status == 'active' || data.status == 'completed')
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidDailyReport(data) {
      return data.keys().hasAll(['id', 'projectId', 'projectName', 'reportDate', 'senderId', 'senderName', 'senderEmail', 'submittedWorks', 'receivedWorks', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'projectId', 'projectName', 'reportDate', 'senderId', 'senderName', 'senderEmail', 'submittedWorks', 'receivedWorks', 'notes', 'attachments', 'status', 'adminFeedback', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.projectId)
        && data.projectName is string && data.projectName.size() <= 200
        && data.reportDate is string && data.reportDate.size() <= 20
        && data.senderId is string && data.senderId.size() <= 128
        && data.senderName is string && data.senderName.size() <= 150
        && data.senderEmail is string && data.senderEmail.size() <= 200
        && data.submittedWorks is list && data.submittedWorks.size() <= 200
        && data.receivedWorks is list && data.receivedWorks.size() <= 200
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 4000))
        && (!('attachments' in data) || (data.attachments is list && data.attachments.size() <= 20))
        && (data.status == 'submitted' || data.status == 'reviewed' || data.status == 'needs_revision')
        && (!('adminFeedback' in data) || (data.adminFeedback is string && data.adminFeedback.size() <= 2000))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidIssueReport(data) {
      return data.keys().hasAll(['id', 'issueNumber', 'projectId', 'projectName', 'authorId', 'authorName', 'type', 'priority', 'description', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'issueNumber', 'projectId', 'projectName', 'authorId', 'authorName', 'type', 'priority', 'description', 'photoUrl', 'status', 'adminComment', 'resolvedAt', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.issueNumber is string && data.issueNumber.size() <= 40
        && isValidId(data.projectId)
        && data.projectName is string && data.projectName.size() <= 200
        && data.authorId is string && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() <= 150
        && data.type in ['equipment', 'network', 'electrical_ac', 'documents_archive', 'other']
        && (data.priority == 'normal' || data.priority == 'urgent')
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 4000
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 900000))
        && data.status in ['new', 'in_progress', 'resolved']
        && (!('adminComment' in data) || (data.adminComment is string && data.adminComment.size() <= 2000))
        && (!('resolvedAt' in data) || (data.resolvedAt is string && data.resolvedAt.size() <= 64))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidProjectTask(data) {
      return data.keys().hasAll(['id', 'projectId', 'projectName', 'title', 'description', 'deadline', 'priority', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'projectId', 'projectName', 'title', 'description', 'deadline', 'priority', 'status', 'createdBy', 'completedBy', 'completedAt', 'proofNote', 'proofAttachment', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.projectId)
        && data.projectName is string && data.projectName.size() <= 200
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.description is string && data.description.size() <= 4000
        && data.deadline is string && data.deadline.size() <= 20
        && (data.priority == 'normal' || data.priority == 'urgent')
        && data.status in ['pending', 'in_progress', 'done']
        && data.createdBy is string && data.createdBy.size() <= 128
        && (!('completedBy' in data) || (data.completedBy is string && data.completedBy.size() <= 150))
        && (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 64))
        && (!('proofNote' in data) || (data.proofNote is string && data.proofNote.size() <= 2000))
        && (!('proofAttachment' in data) || (data.proofAttachment is string && data.proofAttachment.size() <= 1000))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['id', 'title', 'content', 'targetProjects', 'isUrgent', 'createdBy', 'authorName', 'readBy', 'createdAt'])
        && data.keys().hasOnly(['id', 'title', 'content', 'targetProjects', 'isUrgent', 'createdBy', 'authorName', 'readBy', 'createdAt'])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 5000
        && data.targetProjects is list && data.targetProjects.size() <= 100
        && data.isUrgent is bool
        && data.createdBy is string && data.createdBy.size() <= 128
        && data.authorName is string && data.authorName.size() <= 150
        && data.readBy is list && data.readBy.size() <= 500
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Users collection (PII isolated to owner or Admin)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isAdmin() || (isSignedIn() && request.auth.uid == userId));
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isAdmin() && isValidUserProfile(incoming());
      allow update: if isValidId(userId) && isAdmin() && isValidUserProfile(incoming())
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(userId) && isAdmin() && existing().email != 'elmassacloud@gmail.com';
    }

    // Projects collection
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && hasProjectAccess(projectId);
      allow list: if isAdmin() || (isActiveUser() && (currentUserData().allProjects == true || resource.data.id in currentUserData().assignedProjects));
      allow create: if isValidId(projectId) && isAdmin() && isValidProject(incoming());
      allow update: if isValidId(projectId) && isAdmin() && isValidProject(incoming())
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(projectId) && isAdmin();
    }

    // Daily Reports collection
    match /reports/{reportId} {
      allow get: if isValidId(reportId) && hasProjectAccess(existing().projectId);
      allow list: if isAdmin() || (isActiveUser() && (currentUserData().allProjects == true || resource.data.projectId in currentUserData().assignedProjects));
      allow create: if isValidId(reportId)
        && isValidDailyReport(incoming())
        && hasProjectAccess(incoming().projectId)
        && (isAdmin() || incoming().senderId == request.auth.uid)
        && incoming().status == 'submitted';
      allow update: if isValidId(reportId)
        && isAdmin()
        && isValidDailyReport(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminFeedback', 'updatedAt']);
      allow delete: if isValidId(reportId) && isAdmin();
    }

    // Issue Reports collection
    match /issues/{issueId} {
      allow get: if isValidId(issueId) && hasProjectAccess(existing().projectId);
      allow list: if isAdmin() || (isActiveUser() && (currentUserData().allProjects == true || resource.data.projectId in currentUserData().assignedProjects));
      allow create: if isValidId(issueId)
        && isValidIssueReport(incoming())
        && hasProjectAccess(incoming().projectId)
        && (isAdmin() || incoming().authorId == request.auth.uid)
        && incoming().status == 'new';
      allow update: if isValidId(issueId)
        && isAdmin()
        && isValidIssueReport(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminComment', 'resolvedAt', 'updatedAt']);
      allow delete: if isValidId(issueId) && isAdmin();
    }

    // Project Tasks collection
    match /tasks/{taskId} {
      allow get: if isValidId(taskId) && hasProjectAccess(existing().projectId);
      allow list: if isAdmin() || (isActiveUser() && (currentUserData().allProjects == true || resource.data.projectId in currentUserData().assignedProjects));
      allow create: if isValidId(taskId) && isAdmin() && isValidProjectTask(incoming());
      allow update: if isValidId(taskId)
        && isValidProjectTask(incoming())
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (
            hasProjectAccess(existing().projectId)
            && incoming().projectId == existing().projectId
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedBy', 'completedAt', 'proofNote', 'proofAttachment', 'updatedAt'])
          )
        );
      allow delete: if isValidId(taskId) && isAdmin();
    }

    // Announcements collection
    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && isActiveUser();
      allow list: if isAdmin() || isActiveUser();
      allow create: if isValidId(announcementId) && isAdmin() && isValidAnnouncement(incoming());
      allow update: if isValidId(announcementId)
        && isValidAnnouncement(incoming())
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (
            isActiveUser()
            && incoming().diff(existing()).affectedKeys().hasOnly(['readBy'])
          )
        );
      allow delete: if isValidId(announcementId) && isAdmin();
    }
  }
}
